+// Decode the reserved compiler specialization name. Hex fields are used
+// so arbitrary import paths, struct tags and Unicode names are lossless.
+bool
+Named_type::compat_generic_metadata(std::string* identity, std::string* pkgpath,
+                                    std::string* pkgname, std::string* display) const
+{
+  std::string name = Gogo::unpack_hidden_name(this->named_object_->name());
+  const std::string prefix = "GccgoCompatType_";
+  if (name.compare(0, prefix.size(), prefix) != 0)
+    return false;
+  std::string* targets[] = { identity, pkgpath, pkgname, display };
+  size_t start = prefix.size();
+  for (unsigned int field = 0; field < 4; ++field)
+    {
+      size_t end = name.find('_', start);
+      if (field == 3)
+        {
+          if (end != std::string::npos)
+            return false;
+          end = name.size();
+        }
+      else if (end == std::string::npos)
+        return false;
+      if (end == start || (end - start) % 2 != 0)
+        return false;
+      std::string value;
+      for (size_t pos = start; pos < end; pos += 2)
+        {
+          unsigned int byte = 0;
+          for (unsigned int digit = 0; digit < 2; ++digit)
+            {
+              char c = name[pos + digit];
+              if (c >= '0' && c <= '9')
+                byte = byte * 16 + (c - '0');
+              else if (c >= 'a' && c <= 'f')
+                byte = byte * 16 + (c - 'a' + 10);
+              else
+                return false;
+            }
+          value.push_back(static_cast<char>(byte));
+        }
+      if (targets[field] != NULL)
+        *targets[field] = value;
+      start = end + 1;
+    }
+  return true;
+}
