+bool
+Builtin_call_expression::do_string_constant_value(std::string* value)
+{
+  if ((this->code_ != BUILTIN_MIN && this->code_ != BUILTIN_MAX)
+      || !this->is_constant() || !this->minmax_type()->is_string_type())
+    return false;
+  this->args()->front()->string_constant_value(value);
+  for (Expression_list::const_iterator p = this->args()->begin() + 1;
+       p != this->args()->end(); ++p)
+    {
+      std::string other;
+      (*p)->string_constant_value(&other);
+      if ((this->code_ == BUILTIN_MIN && other < *value)
+          || (this->code_ == BUILTIN_MAX && other > *value))
+        *value = other;
+    }
+  return true;
+}
