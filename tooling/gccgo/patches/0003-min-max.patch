+// min/max use the same operand type rules as addition, but must not
+// evaluate a synthetic sum: that could overflow otherwise valid constants.
+Type*
+Builtin_call_expression::minmax_type() const
+{
+  const Expression_list* args = this->args();
+  if (args == NULL || args->empty())
+    return Type::make_error_type();
+  Type* typed = NULL;
+  Type* untyped = NULL;
+  for (Expression_list::const_iterator p = args->begin(); p != args->end(); ++p)
+    {
+      Type* t;
+      if (!(*p)->is_untyped(&t))
+        {
+          (*p)->determine_type_no_context(this->gogo_);
+          t = (*p)->type();
+          if (typed != NULL && !Type::are_identical(typed, t, 0, NULL))
+            return Type::make_error_type();
+          typed = t;
+        }
+      else if (untyped == NULL)
+        untyped = t;
+      else if (untyped->is_numeric_type() && t->is_numeric_type())
+        {
+          if (t->complex_type() != NULL || untyped->complex_type() != NULL)
+            untyped = Type::make_abstract_complex_type();
+          else if (t->float_type() != NULL || untyped->float_type() != NULL)
+            untyped = Type::make_abstract_float_type();
+          else if (t->integer_type()->is_rune()
+                   || untyped->integer_type()->is_rune())
+            untyped = Type::make_abstract_character_type();
+        }
+      else if (!Type::are_identical(untyped, t, 0, NULL))
+        return Type::make_error_type();
+      if (t->integer_type() == NULL && t->float_type() == NULL
+          && !t->is_string_type())
+        return Type::make_error_type();
+    }
+  if (typed != NULL && untyped != NULL
+      && !((typed->is_numeric_type() && untyped->is_numeric_type())
+           || (typed->is_string_type() && untyped->is_string_type())))
+    return Type::make_error_type();
+  Type* result = typed != NULL ? typed : untyped;
+  if (result == NULL
+      || (result->integer_type() == NULL && result->float_type() == NULL
+          && !result->is_string_type()))
+    return Type::make_error_type();
+  return result;
+}
